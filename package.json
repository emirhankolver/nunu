{
  "name": "nunu-ai-site",
  "private": true,
  "version": "1.0.0",
  "description": "Static website for the Nunu AI app (landing page, privacy policy, terms of use, support).",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch",
    "vendor": "node scripts/copy-fontawesome.mjs",
    "build": "npm run vendor && npm run build:css",
    "dev": "npx --yes serve . -l 4000",
    "dist": "node scripts/build-dist.mjs"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
